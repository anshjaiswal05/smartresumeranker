rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || true);
    }

    // Structured resume analysis documents
    match /resumes/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || true);
    }
    match /resumeAnalyses/{analysisId} {
      allow read, write: if request.auth != null;
    }

    // Resume Builder documents
    match /resumeBuilderDocuments/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || true);
    }

    // Skill Gap Analyses
    match /skillGapAnalyses/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || true);
    }

    // Learning Roadmap Progress
    match /roadmapProgress/{docId} {
      allow read, write: if request.auth != null;
    }

    // Mock Interviews & Question banks
    match /mockInterviews/{interviewId} {
      allow read, write: if request.auth != null;
    }
    match /usedInterviewQuestions/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || true);
    }

    // Saved Jobs
    match /savedJobs/{docId} {
      allow read, write: if request.auth != null;
    }

    // Generated Documents & Cover Letters
    match /generatedDocuments/{docId} {
      allow read, write: if request.auth != null;
    }

    // Activity Logs
    match /activityLogs/{logId} {
      allow read, write: if request.auth != null;
    }

    // General fallback rule for authenticated requests and initial setup
    match /{document=**} {
      allow read, write: if request.auth != null || request.time < timestamp.date(2026, 12, 31);
    }
  }
}
